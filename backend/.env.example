# AgroTech Boyacá — Environment variables (AG-12)
# Copy to `.env` for local development. Never commit real secrets.
# Consoles: see ../infra/PROVISIONING.md

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL — Supabase
# Dashboard → Project Settings → Database → Connection string (URI)
# Prefer "Transaction" pooler (port 6543) for the API on Render.
# pg_dump / restore (AG-40) MUST use DIRECT_URL session pooler (port 5432), never 6543.
# Direct host `db.*.supabase.co:5432` is often IPv6-only; GitHub Actions is IPv4.
# Backup job uses session pooler: same user/password/host as DATABASE_URL but port 5432, no pgbouncer=true.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Redis — Upstash
# Console → Redis → REST API / Redis URL
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://[ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:[PASSWORD]@[ID].upstash.io:6379

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible)
# R2 → Manage R2 API Tokens + bucket public/custom domain later
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agrotech-boyaca
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Firebase — Authentication (OTP SMS) + FCM
# Service account JSON path (local) or raw JSON in FIREBASE_SERVICE_ACCOUNT
# Mobile uses google-services.json (gitignored) — see PROVISIONING.md
# Local files (never commit): backend/.env, backend/secrets/firebase-adminsdk.json,
# mobile/android/app/google-services.json
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n escaped, or load from file in a later ticket
FIREBASE_PRIVATE_KEY=
# Optional: path to service-account JSON for local only
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json

# -----------------------------------------------------------------------------
# JWT (RS256) — kernel verifies only; Auth ticket will issue tokens
# Paste PEM with literal \n (quoted). Private key stays with Auth / secrets manager.
# -----------------------------------------------------------------------------
JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
JWT_ACCESS_TTL_NATURAL=15m
JWT_ACCESS_TTL_JURIDICA=60m

# -----------------------------------------------------------------------------
# Throttle — 100 req / 60s per IP (Redis if REDIS_URL is set, else in-memory)
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Render Web Service (no pongas PORT: Render lo inyecta)
# Dashboard → tu servicio → Settings → URL
# -----------------------------------------------------------------------------
APP_PUBLIC_URL=
RENDER_SERVICE_NAME=
RENDER_REGION=
