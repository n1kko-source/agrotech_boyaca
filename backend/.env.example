# AgroTech Boyacá — Environment variables (AG-12)
# Copy to `.env` for local development. Never commit real secrets.
# Consoles: see ../infra/PROVISIONING.md

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL — Supabase
# Dashboard → Project Settings → Database → Connection string (URI)
# Prefer "Transaction" pooler (port 6543) for the API on Render.
# pg_dump / restore (AG-40) MUST use DIRECT_URL session pooler (port 5432), never 6543.
# Direct host `db.*.supabase.co:5432` is often IPv6-only; GitHub Actions is IPv4.
# Backup job uses session pooler: same user/password/host as DATABASE_URL but port 5432, no pgbouncer=true.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Redis — Upstash
# Console → Redis → REST API / Redis URL
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://[ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:[PASSWORD]@[ID].upstash.io:6379

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible)
# R2 → Manage R2 API Tokens + bucket public/custom domain later
# Guías (AG-26): prefix guias/. Backups stay in backups/postgres/.
# GET /health → r2 { storageBytes, storageLimit: 10GB, reads, readsLimit: 1M, month }
# Audio is transcoded to Opus 16 kbps / mono / 16 kHz (ffmpeg in the Docker image).
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agrotech-boyaca
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Firebase — Authentication (OTP SMS NATURAL + email/password JURIDICA) + FCM
# Service account JSON path (local) or raw JSON in FIREBASE_SERVICE_ACCOUNT
# FCM HTTP v1 (AG-24) uses FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
# Without those three, push is skipped and notifications stay in the Postgres inbox.
# Mobile uses google-services.json (gitignored) — see PROVISIONING.md
# Local files (never commit): backend/.env, backend/secrets/firebase-adminsdk.json,
# mobile/android/app/google-services.json
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n escaped, or load from file in a later ticket
FIREBASE_PRIVATE_KEY=
# Web API key (Project settings → General). Identity Toolkit OTP SMS from the API.
FIREBASE_WEB_API_KEY=
# Optional: path to service-account JSON for local only
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json

# -----------------------------------------------------------------------------
# JWT (RS256) — Auth (AG-15) signs; kernel verifies. Production boot rejects RSA < 2048.
# Paste PEM with literal \n (quoted). Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# -----------------------------------------------------------------------------
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ACCESS_TTL_NATURAL=15m
JWT_ACCESS_TTL_JURIDICA=60m
JWT_REFRESH_TTL_NATURAL=7d
JWT_REFRESH_TTL_JURIDICA=30d

# -----------------------------------------------------------------------------
# PII (Ley 1581) — pgcrypto AES-256 + HMAC lookup. Never log these.
# Production boot requires each ≥32 chars and rejects the literal `dev-pepper`.
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=

# -----------------------------------------------------------------------------
# Mail (AG-17) — email when a JURIDICA account is verified. Logging stub if unset.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# -----------------------------------------------------------------------------
# Clima (AG-25) — OpenWeather Current Weather + 5 day / 3 hour forecast
# https://openweathermap.org/api — key en Account → API keys (free tier).
# Sin OPENWEATHER_API_KEY, GET /clima/:municipio responde 503.
# Job: POST /clima/jobs/evaluate con header x-clima-job-secret (cron-job.org cada 3 h).
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=
CLIMA_JOB_SECRET=

# -----------------------------------------------------------------------------
# Suscripciones (AG-29) — job diario de recordatorios (gracia 4 días)
# Cron: POST /suscripciones/jobs/evaluate con header x-suscripciones-job-secret
# (cron-job.org, diario). No uses @Cron de Nest: Render Free hiberna.
# -----------------------------------------------------------------------------
SUSCRIPCIONES_JOB_SECRET=

# -----------------------------------------------------------------------------
# Throttle — 100 req / 60s per IP (Redis if REDIS_URL is set, else in-memory)
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Render Web Service (no pongas PORT: Render lo inyecta)
# Dashboard → tu servicio → Settings → URL
# -----------------------------------------------------------------------------
APP_PUBLIC_URL=
RENDER_SERVICE_NAME=
RENDER_REGION=
