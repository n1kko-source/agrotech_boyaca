{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(.*\\.mjs$)|@nestjs/config|@nestjs/throttler|@nestjs/jwt|nestjs-pino|pino-http|pino/|helmet|ioredis)"
  ]
}
