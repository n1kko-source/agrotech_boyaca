generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  NATURAL
  JURIDICA
  ADMIN
}

enum EntityType {
  ASOCIACION
  COOPERATIVA
  EMPRESA
}

/// PII ciphertext is pgcrypto AES-256; lookup uses HMAC. NATURAL uses phone;
/// JURIDICA uses email + NIT; ADMIN uses email only (seeded, never public register).
model User {
  id          String      @id @db.Uuid
  role        Role        @default(NATURAL)
  phoneEnc    Bytes?      @map("phone_enc")
  phoneHash   String?     @unique @map("phone_hash")
  emailEnc    Bytes?      @map("email_enc")
  emailHash   String?     @unique @map("email_hash")
  nitEnc      Bytes?      @map("nit_enc")
  nitHash     String?     @unique @map("nit_hash")
  entityType  EntityType? @map("entity_type")
  verified    Boolean     @default(false)
  firebaseUid             String?   @unique @map("firebase_uid")
  privacyPolicyVersion    String?   @map("privacy_policy_version")
  privacyPolicyAcceptedAt DateTime? @map("privacy_policy_accepted_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  posts                   Post[]
  profile                 MarketplaceProfile?
  commodityPrices         CommodityPrice[]
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  weatherAlerts           WeatherAlert[]
  guias                   Guia[]
  conversationsStarted    Conversation[] @relation("ConversationInitiator")
  conversationsReceived   Conversation[] @relation("ConversationPeer")
  messagesSent            Message[]

  @@map("users")
}

/// Operator actions on JURIDICA verification. Stores UUIDs only (no PII).
model VerificationEvent {
  id           String   @id @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  verified     Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetUserId])
  @@map("verification_events")
}

/// Habeas data deletion request (Ley 1581). UUIDs only. Support fulfills by hand in MVP.
model DeletionRequest {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("deletion_requests")
}

/// Marketplace listing (not PII). FTS lives in a generated tsvector column
/// (`search_vector`) created in SQL; Prisma does not map that column.
model Post {
  id          String   @id @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  title       String
  description String
  category    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([authorId])
  @@map("posts")
}

/// 1:1 thread between a listing author and one interested user. Not PII.
/// Unique per (post, initiator) so 2G retries do not duplicate the thread.
model Conversation {
  id          String   @id @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  initiatorId String   @map("initiator_id") @db.Uuid
  peerId      String   @map("peer_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  initiator  User      @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  peer       User      @relation("ConversationPeer", fields: [peerId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([postId, initiatorId])
  @@index([initiatorId])
  @@index([peerId])
  @@map("conversations")
}

/// Short text only (no attachments in v1). Evidence for Modelo B metrics.
model Message {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Public producer/buyer card. No phone, email, or NIT.
model MarketplaceProfile {
  id           String   @id @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  displayName  String   @map("display_name")
  municipality String
  bio          String   @default("")
  category     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("marketplace_profiles")
}

/// Latest COP price per product + region. Not PII. Cache lives in Redis, not here.
model CommodityPrice {
  id         String   @id @db.Uuid
  producto   String
  region     String
  precio     Decimal  @db.Decimal(12, 2)
  unidad     String   @default("kg")
  moneda     String   @default("COP")
  reportedBy String   @map("reported_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reporter User @relation(fields: [reportedBy], references: [id], onDelete: Restrict)

  @@unique([producto, region])
  @@map("commodity_prices")
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
}

/// FCM registration token per device. Not PII. Unique token so a reinstall
/// moves the device to the current user.
model DeviceToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String
  deviceId  String   @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_tokens")
}

/// Push inbox. PENDING if FCM could not accept (no token / offline provider).
/// SENT when FCM accepted (store-and-forward). DELIVERED when the client acks.
model Notification {
  id        String               @id @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  title     String
  body      String
  data      Json                 @default("{}")
  status    NotificationStatus   @default(PENDING)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

/// Configurable weather threshold per user + municipality. Not PII.
/// `kind` is validated in the API (`rain` | `frost`), stored as text.
model WeatherAlert {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  municipio   String
  kind        String
  enabled     Boolean   @default(true)
  lastFiredAt DateTime? @map("last_fired_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, municipio, kind])
  @@index([enabled, municipio])
  @@map("weather_alerts")
}

/// Technical guide metadata. Bytes live in R2 under `guias/`. Not PII.
model Guia {
  id         String   @id @db.Uuid
  titulo     String
  categoria  String
  subsector  String
  kind       String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  objectKey  String   @unique @map("object_key")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([categoria, createdAt])
  @@map("guias")
}

/// App-metered Class B reads against R2 (guias downloads). Month is UTC YYYY-MM.
model R2MonthlyRead {
  month     String   @id
  reads     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("r2_monthly_reads")
}
