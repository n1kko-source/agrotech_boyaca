# =============================================================================
# AgroTech Boyacá — .gitignore
# NestJS + Flutter + Prisma + Render / Firebase / R2
# =============================================================================

# -----------------------------------------------------------------------------
# Documentos de contexto local (no versionar en el repo)
# -----------------------------------------------------------------------------
/BASE_INFRAESTRUCTURA.md
/CONTEXTO.md

# -----------------------------------------------------------------------------
# Secrets & entorno (Ley 1581 — nunca versionar PII/credenciales)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p8
*.p12
*.key
*.crt
*.jks
*.keystore
secrets/
**/secrets/
credentials/
service-account*.json
*firebase-adminsdk*.json
google-services.json
**/google-services.json
GoogleService-Info.plist
firebase_options.dart
**/firebase_options.dart
**/firebase_app_id_file.json

# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

